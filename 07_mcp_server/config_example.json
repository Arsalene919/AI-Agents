{
  "mcpServers": {
    "research-assistant": {
      "command": "python",
      "args": ["server.py"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {"GITHUB_TOKEN": "YOUR_GITHUB_TOKEN"}
    },
    "gdrive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {"GDRIVE_CREDENTIALS": "path/to/your/credentials.json"}
    }
  }
}